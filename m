+static int ocfs2_validate_local_quota_info(struct super_block *sb,
+    struct inode *lqinode,
+    int type,
+    struct ocfs2_mem_dqinfo *oinfo)
+{
+ u64 file_blocks =3D i_size_read(lqinode) >> sb->s_blocksize_bits;
+ u64 chunk_blocks =3D ol_chunk_blocks(sb);
+ u64 chunks =3D oinfo->dqi_chunks;
+ u64 blocks =3D oinfo->dqi_blocks;
+ u64 last_chunk, min_blocks, max_blocks;
+
+ if (oinfo->dqi_flags & ~OLQF_CLEAN) {
+ mlog(ML_ERROR, "Invalid local quota flags 0x%x (type=3D%d)\n",
+      oinfo->dqi_flags, type);
+ return -EFSCORRUPTED;
+ }
+
+ if (blocks < 1 || blocks > file_blocks) {
+ mlog(ML_ERROR, "Invalid local quota blocks %llu/%llu (type=3D%d)\n",
+      (unsigned long long)blocks,
+      (unsigned long long)file_blocks, type);
+ return -EFSCORRUPTED;
+ }
+
+ if (!chunks) {
+ if (blocks !=3D 1) {
+ mlog(ML_ERROR, "Invalid zero-chunk quota blocks %llu (type=3D%d)\n",
+      (unsigned long long)blocks, type);
+ return -EFSCORRUPTED;
+ }
+ return 0;
+ }
+
+ if (chunks > INT_MAX) {
+ mlog(ML_ERROR, "Too many local quota chunks %llu (type=3D%d)\n",
+      (unsigned long long)chunks, type);
+ return -EFSCORRUPTED;
+ }
+
+ last_chunk =3D 1 + (chunk_blocks + 1) * (chunks - 1);
+ if (last_chunk > UINT_MAX) {
+ mlog(ML_ERROR, "Local quota chunk block %llu overflows (type=3D%d)\n",
+      (unsigned long long)last_chunk, type);
+ return -EFSCORRUPTED;
+ }
+
+ min_blocks =3D last_chunk + 1;
+ max_blocks =3D last_chunk + 1 + chunk_blocks;
+ if (blocks < min_blocks || blocks > max_blocks) {
+ mlog(ML_ERROR, "Invalid quota geometry %llu/%llu [%llu, %llu] (type=3D%d)=
\n",
+      (unsigned long long)chunks,
+      (unsigned long long)blocks,
+      (unsigned long long)min_blocks,
+      (unsigned long long)max_blocks, type);
+ return -EFSCORRUPTED;
+ }
+
+ return 0;
+}
